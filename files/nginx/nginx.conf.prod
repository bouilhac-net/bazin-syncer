user nginx;
worker_processes auto;

error_log  /var/log/nginx/error.log warn;
pid        /var/run/nginx.pid;

events {
    worker_connections  1024;
}

http {
    include             /etc/nginx/mime.types;
    default_type        application/octet-stream;
    log_format          combined_realip '[$time_local] $http_x_real_ip "$request" $status $body_bytes_sent $upstream_response_time "$http_referer" "$http_user_agent"';
    access_log          /var/log/nginx/access.log combined_realip;
    sendfile            on;
    keepalive_timeout   65;

    client_max_body_size 10M;

    gzip on;
    gzip_disable "msie6";

    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_buffers 16 8k;
    gzip_http_version 1.1;
    gzip_min_length 256;
    gzip_types
        application/javascript
        application/json
        application/ld+json
        application/manifest+json
        application/xml
        font/eot
        font/otf
        font/ttf
        image/svg+xml
        text/css
        text/javascript
        text/plain
        text/xml;

    server {
        listen 80 default_server;
        listen [::]:80 default_server;
        http2               on;
        keepalive_timeout   70;

        root /app/web/public/;
        index index.php index.html;

        location /api/ {
            auth_basic "API access";
            auth_basic_user_file /app/files/nginx/.htpasswd-api;

            location ~\.php$ {
                try_files $uri = 404;
                fastcgi_split_path_info ^(.+\.php)(/.+)$;
                fastcgi_pass php:9000;
                fastcgi_index index.php;
                include fastcgi_params;
                fastcgi_param REQUEST_URI $request_uri;
                fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
                fastcgi_param PATH_INFO $fastcgi_path_info;
            }
        }

        location / {
            auth_basic  "Syncer administration";
            auth_basic_user_file /app/files/nginx/.htpasswd;

            location ~\.php$ {
                try_files $uri = 404;
                fastcgi_split_path_info ^(.+\.php)(/.+)$;
                fastcgi_pass php:9000;
                fastcgi_index index.php;
                include fastcgi_params;
                fastcgi_param REQUEST_URI $request_uri;
                fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
                fastcgi_param PATH_INFO $fastcgi_path_info;
            }
        }

        location ~ /\.ht {
            deny all;
        }
    }
}
