{
    "repositories": [
        {
            "type": "composer",
            "url": "https://satis.solutions-cvhu.fr"
        }
    ],
    "require": {
        "solutions-cvhu/syncer": "^1.0",
        "solutions-cvhu/syncer-ovoko": "^1.0",
        "solutions-cvhu/syncer-totalparts": "^1.0",
        "solutions-cvhu/syncer-francecasse": "^1.0"
    },
    "scripts": {
        "post-install-cmd": ["@installAdmin", "@installOvokoWebhook"],
        "post-update-cmd": ["@installAdmin", "@installOvokoWebhook"],
        "installAdmin": "cp -r ./vendor/solutions-cvhu/syncer/web/ ./",
        "installOvokoWebhook": "cp ./vendor/solutions-cvhu/syncer-ovoko/web/public/* ./web/public/"
    },
    "autoload": {
        "psr-4": {
            "Bazin\\Syncer\\": "src/"
        }
    }
}
